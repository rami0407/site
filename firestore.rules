rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛡️ SECURITY & AUTHORIZATION DEFINITIONS
    // ==========================================

    // Check if user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // 👑 Super Administrator check: Strictly limited to Principal Rami / Official School Admin Emails
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rami0407@gmail.com' ||
        request.auth.token.email == 'musheirifa.primary@gmail.com' ||
        request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@musheirifa\\.edu\\.(ps|il)$')
      );
    }

    // 👨‍🏫 Verified School Educator / Teacher
    function isTeacher() {
      return request.auth != null && (
        isSuperAdmin() ||
        request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@musheirifa\\.edu\\.(ps|il|hl)$') ||
        request.auth.token.email.matches('^teacher.*')
      );
    }

    // 🛡️ Verified Gate Guard
    function isGuard() {
      return request.auth != null && (
        isSuperAdmin() ||
        request.auth.token.email.matches('^guard.*@musheirifa\\.edu\\.(ps|il)$') ||
        request.auth.token.email == 'guard@musheirifa.edu.ps'
      );
    }

    // Input string validation helpers
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // ==========================================
    // 1. LANDING PAGE & CORE IDENTITY (SUPER ADMIN ONLY)
    // ==========================================

    // 🎓 كلمة مدير المدرسة — محمية بقفل السوبر أدمن حصراً
    match /principal/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🌟 القيم المدرسية في الواجهة
    match /values/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🚀 المبادرات المدرسية في الواجهة الرئيسية
    match /initiatives/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 📄 الصفحات الرسمية وقوائم الموقع
    match /pages/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /navigation/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /contactDetails/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /schoolGuide/{docId} {
      // 🛡️ Prevent exposure of AI API keys and sensitive dismissal mirrors
      // gemini (AI API keys): Strictly SuperAdmin only
      // latest_dismissal: Only verified staff/guard/superAdmin
      // other public pages: public read
      allow read: if (docId == 'gemini' && isSuperAdmin())
                  || (docId == 'latest_dismissal' && (isTeacher() || isGuard() || isSuperAdmin()))
                  || (docId != 'gemini' && docId != 'latest_dismissal');
      allow write: if isSuperAdmin() || (docId == 'latest_dismissal' && isTeacher());
    }

    // ==========================================
    // 2. DYNAMIC SCHOOL CONTENT (SUPER ADMIN ONLY)
    // ==========================================

    match /news/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /calendar/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /links/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /books/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /uniform/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /astronomy/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /challenge/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /kiosk_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /display_board/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 3. TEACHERS & ROSTER DATA (PROTECTED)
    // ==========================================

    match /teachers/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /school_teachers/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /teacher_scores/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 4. CONTACTS & MESSAGES (PRIVACY PROTECTION)
    // ==========================================

    match /contacts/{docId} {
      allow create: if isValidString(request.resource.data.fullName, 2, 120)
                    && isValidString(request.resource.data.message, 2, 3500);
      allow read, update, delete: if isSuperAdmin();
    }

    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // 🛡️ سجلات الأمان والتدقيق السحابي (محمية حصراً للمدير العام)
    match /security_audit_logs/{docId} {
      allow create: if isValidString(request.resource.data.type, 2, 100)
                    && isValidString(request.resource.data.details, 2, 1200);
      allow read, update, delete: if isSuperAdmin();
    }

    // 🔐 إعدادات أمان النظام وأجهزة الحراسة
    match /system_security/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /system_settings/{docId} {
      // guard_config can be read by guard or super admin; others strictly super admin
      allow read: if isSuperAdmin() || (docId == 'guard_config' && isGuard());
      allow write: if isSuperAdmin();
    }

    // 👨‍🏫 حسابات ورموز المعلمين السرية
    match /teacher_accounts/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 5. APPOINTMENTS & GATE VISITOR LOGS
    // ==========================================

    match /teacher_appointments/{docId} {
      // 🛡️ Privacy protection: Only verified staff, guards, and admins can view appointments & visitor logs
      allow read: if isTeacher() || isGuard() || isSuperAdmin();
      allow create: if isValidString(request.resource.data.parentName, 2, 100)
                    && isValidString(request.resource.data.date, 8, 20);
      // Guard can ONLY update entryStatus, enteredAt, gateStatus; SuperAdmin can update all
      allow update: if isSuperAdmin()
                    || (isGuard() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entryStatus', 'enteredAt', 'status', 'gateStatus', 'actualExitTime', 'gateExitTime']));
      allow delete: if isSuperAdmin();
    }

    // 📅 Public non-sensitive slot availability for booking calendar
    match /appointment_slots/{slotId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 6. POLLS, SURVEYS & FORMS
    // ==========================================

    match /parent_polls/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /school_surveys/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /survey_responses/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 7. STUDENT ACTIVITIES & SUBMISSIONS
    // ==========================================

    // 📚 أوراق العمل - القراءة والتحميل متاح للجميع، والتعديل والإضافة للإدارة حصراً
    match /worksheets/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🔬 المقالات العلمية - القراءة متاحة للجميع، والتعديل للإدارة حصراً
    match /scientific_articles/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🎨 رسومات الطلاب - الإرسال متاح للطلاب، والتعديل والحذف للإدارة حصراً
    match /prep_drawings/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /stem_solutions/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /stem_teacher_requests/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // 💡 أفكار الطلاب - المشاركة والإعجاب متاح، والحذف للإدارة حصراً
    match /world_ideas/{docId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if isSuperAdmin();
    }

    match /world_ideas_comments/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // 📖 بيانات الطلاب / نادي القراء - التسجيل متاح، والتعديل والحذف للإدارة حصراً
    match /students/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /stars/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🌟 سماء الامتنان - الإطلاق متاح، والإعجاب متاح، والحذف للإدارة حصراً
    match /gratitude_stars/{docId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']));
      allow delete: if isSuperAdmin();
    }

    match /readers_club_logs/{docId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']));
      allow delete: if isSuperAdmin();
    }

    match /readers_club_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 📢 منظومة إشعارات المدرسة للهواتف وشاشة العرض
    match /school_notifications/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /views/{viewId} {
        allow read, create: if true;
      }
    }

    match /notification_subscribers/{docId} {
      allow create: if isValidString(request.resource.data.deviceId, 4, 120)
                    && request.resource.data.deviceId == docId;
      allow update: if isSuperAdmin()
                    || (isValidString(request.resource.data.deviceId, 4, 120)
                        && request.resource.data.deviceId == docId
                        && resource.data.deviceId == docId);
      allow read, delete: if isSuperAdmin();
    }

    // 🏛️ المعرض الافتراضي ثلاثي الأبعاد
    match /museum_artworks/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
    }

    // 🎒 ركن المفقودات والموجودات المدرسية
    match /lost_and_found/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /lost_found_claims/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // 👨‍👩‍👧‍👦 تحدي العائلة الأسبوعي
    match /family_challenge_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /family_hall_of_fame/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🏃‍♂️ منظومة تسريح الطلاب وإذن الخروج اليومي
    match /student_dismissals/{docId} {
      // 🛡️ Privacy protection: Only verified teachers, guard, and admin can view dismissal permits
      allow read: if isTeacher() || isGuard() || isSuperAdmin();
      // Only authenticated teachers or admin can issue student dismissals
      allow create: if (isTeacher() || isSuperAdmin())
                    && isValidString(request.resource.data.studentName, 2, 100)
                    && isValidString(request.resource.data.date, 8, 20);
      // Guard can ONLY update gate exit status fields; SuperAdmin can update all
      allow update: if isSuperAdmin()
                    || (isGuard() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'gateStatus', 'entryStatus', 'actualExitTime', 'gateExitTime', 'confirmedAt', 'confirmedBy', 'guardNotes']));
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 8. DEFAULT CATCH-ALL (DENY BY DEFAULT)
    // ==========================================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
