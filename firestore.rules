rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛡️ SECURITY & AUTHORIZATION DEFINITIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // 👑 قفل الإدارة العليا: محصور حصراً بإيميلات المدير المعتمدة
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rami0407@gmail.com' ||
        request.auth.token.email == 'musheirifa.primary@gmail.com' ||
        request.auth.token.email == 'admin@musheirifa.edu.ps' ||
        request.auth.token.email == 'principal@musheirifa.edu.ps' ||
        request.auth.token.email.matches('.*@musheirifa\\.edu.*') ||
        request.auth.token.email.matches('rami.*@gmail\\.com')
      );
    }

    // 🛡️ حساب حارس البوابة المعتمد
    function isGuard() {
      return request.auth != null && (
        request.auth.token.email == 'guard@musheirifa.edu.ps' ||
        request.auth.token.email == 'gate.guard@musheirifa.edu.ps'
      );
    }

    // 👨‍🏫 حساب المعلم الموثق
    function isTeacher() {
      return request.auth != null && (
        isSuperAdmin() ||
        request.auth.token.email.matches('.*@musheirifa\\.edu.*')
      );
    }

    // التحقق من صحة النصوص والمدخلات
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // ==========================================
    // 1. هوية المدرسة وبيانات المدير الأساسية
    // ==========================================

    match /principal/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /values/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /initiatives/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /pages/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /navigation/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /contactDetails/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /schoolGuide/{docId} {
      // حماية المفاتيح الحساسة والأسرار
      allow read: if docId != 'gemini' && docId != 'latest_dismissal';
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 2. المحتوى المدرسي الديناميكي
    // ==========================================

    match /news/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /calendar/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /links/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /books/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /uniform/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /astronomy/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /challenge/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /kiosk_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /display_board/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /mafatihLessonPlans/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isTeacher();
    }

    // ==========================================
    // 3. الطاقم والمعلمين
    // ==========================================

    match /teachers/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /school_teachers/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /teacher_scores/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /teacher_accounts/{docId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == docId) || isTeacher();
      allow update: if isSuperAdmin() || (isTeacher() && request.auth.uid == docId);
      allow create, delete: if isSuperAdmin();
    }

    // ==========================================
    // 4. رسائل التواصل وحجز المواعيد وبوابة الحارس
    // ==========================================

    match /contacts/{docId} {
      allow create: if isValidString(request.resource.data.fullName, 2, 120)
                    && isValidString(request.resource.data.message, 2, 3500);
      allow read, update, delete: if isSuperAdmin();
    }
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
    match /teacher_appointments/{docId} {
      allow read: if true;
      allow create: if isValidString(request.resource.data.parentName, 2, 100)
                    && isValidString(request.resource.data.date, 8, 20);
      allow update: if isSuperAdmin() 
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'entryStatus', 'enteredAt', 'status', 'gateStatus', 'actualExitTime', 'gateExitTime'
                       ]));
      allow delete: if isSuperAdmin();
    }
    match /appointment_slots/{slotId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 5. الاستطلاعات والمشاركات
    // ==========================================

    match /parent_polls/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /school_surveys/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /survey_responses/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 6. أوراق العمل والمقالات العلمية
    // ==========================================

    match /worksheets/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /scientific_articles/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 7. أنشطة الطلاب التفاعلية والركن التعليمي
    // ==========================================

    match /prep_drawings/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /stem_solutions/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /stem_teacher_requests/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /world_ideas/{docId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if isSuperAdmin();
    }
    match /world_ideas_comments/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /students/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }
    match /stars/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /gratitude_stars/{docId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']));
      allow delete: if isSuperAdmin();
    }
    match /readers_club_logs/{docId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']));
      allow delete: if isSuperAdmin();
    }
    match /readers_club_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 🏛️ المعرض الافتراضي والمفقودات وتحدي العائلة
    match /museum_artworks/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      allow update: if isSuperAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
    }
    match /lost_and_found/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /lost_found_claims/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
    match /family_challenge_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
    match /family_hall_of_fame/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /service_platform_teachers/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // 📢 منظومة إشعارات المدرسة للهواتف
    match /school_notifications/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      match /views/{viewId} {
        allow read, create: if true;
      }
    }
    match /notification_subscribers/{docId} {
      allow create: if isValidString(request.resource.data.deviceId, 4, 120)
                    && request.resource.data.deviceId == docId;
      allow update: if isSuperAdmin() || (
        isValidString(request.resource.data.deviceId, 4, 120)
        && request.resource.data.deviceId == docId
        && resource.data.deviceId == docId
        && ('secretTokenProof' in request.resource.data)
        && request.resource.data.secretTokenProof == resource.data.secretToken
      );
      allow read, delete: if isSuperAdmin();
    }

    // 🛡️ الأمان والسجلات والتهيئة
    match /security_audit_logs/{docId} {
      allow create: if isValidString(request.resource.data.type, 2, 100)
                    && isValidString(request.resource.data.details, 2, 1200);
      allow read, update, delete: if isSuperAdmin();
    }
    match /system_security/{docId} {
      allow read: if isTeacher() || isGuard() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 8. 🏃‍♂️ منظومة تسريح الطلاب وإذن الخروج اليومي (مدمجة ومحمية)
    // ==========================================
    match /student_dismissals/{docId} {
      // قراءة أذونات الخروج متاحة لمنظومة المدرسة وشاشة حارس البوابة
      allow read: if true;
      // إنشاء إذن خروج: متاح فقط عند توفر بيانات إذن نظامية ومكتملة وموثقة
      allow create: if isSuperAdmin() || isTeacher() || (
        isValidString(request.resource.data.studentName, 2, 100)
        && isValidString(request.resource.data.classroom, 2, 60)
        && isValidString(request.resource.data.date, 8, 20)
        && isValidString(request.resource.data.teacherName, 2, 100)
      );
      // تحديث حالة الخروج عند البوابة من قبل حارس البوابة أو الإدارة (تحديث حقول الحالة والخروج فقط)
      allow update: if isSuperAdmin()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'gateStatus', 'entryStatus', 'actualExitTime', 'gateExitTime', 'confirmedAt', 'confirmedBy', 'guardNotes'
                       ]);
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 9. المنع التلقائي الشامل لأي مسار آخر (DENY BY DEFAULT)
    // ==========================================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
